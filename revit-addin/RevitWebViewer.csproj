<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Add-in Revit Web Viewer — multi-target biar 1 source code jadi 2 DLL:
      net48            -> Revit 2023 (.NET Framework 4.8)
      net8.0-windows   -> Revit 2025 (.NET 8)

    Revit API diambil dari NuGet (Nice3point) — TIDAK perlu Revit terinstall
    untuk build. Jadi bisa di-build di GitHub Actions (lihat
    .github/workflows/build-addin.yml) atau lokal via `dotnet build -c Release`.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AssemblyName>RevitWebViewer</AssemblyName>
    <RootNamespace>RevitWebViewer</RootNamespace>
    <!-- Form Pengaturan (SettingsForm) pakai WinForms. Untuk .NET 8 aktifkan
         lewat properti ini; untuk net48 cukup Reference framework di bawah. -->
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Revit 2023 -> net48. Revit API dari NuGet, tidak ikut di-copy ke output. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2023.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2023.*" />
    <Reference Include="System.Net.Http" />
    <!-- WinForms untuk net48: assembly framework, resolved dari targeting pack. -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Revit 2025 -> net8.0-windows -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" />
  </ItemGroup>

</Project>
