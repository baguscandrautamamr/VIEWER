# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive (OAuth user — file .rvt masuk kuota 15GB akun kamu, gratis)
# Cara dapat semua ini: lihat docs/GOOGLE-DRIVE-SETUP.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Script push-model.mjs (update model 1 command) — hanya dipakai lokal
IFCCONVERT_PATH=C:\ifcconvert\IfcConvert.exe
SUPABASE_BUCKET=models

# Asisten AI di viewer presentasi (opsional — tanpa ini fitur AI disembunyikan).
# Kunci HANYA dipakai server (app/api/ai/route.ts), tidak pernah dikirim ke browser.
ANTHROPIC_API_KEY=
# Opsional: proxy yang kompatibel Messages API, mis. https://api.vikey.ai
ANTHROPIC_BASE_URL=
# Opsional: model. Bawaan claude-opus-5. Lewat proxy vikey bisa diisi mis. openai/gpt-5.6-luna
AI_MODEL=
